{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Blox Documentation",
  "appearance": {
    "default": "dark"
  },
  "colors": {
    "primary": "#016EF5",
    "light": "#016EF5",
    "dark": "#016EF5"
  },
  "background": {
    "color": {
      "light": "#FDFCFB",
      "dark": "#21201C"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "getting-started/welcome",
              "getting-started/common-questions"
            ]
          }
        ]
      },
      {
        "tab": "Features",
        "groups": [
          {
            "group": "Branding",
            "pages": [
              "features/branding/learning-your-brand"
            ]
          },
          {
            "group": "Landing Pages",
            "pages": [
              "features/landing-pages/agent-prompting",
              "features/landing-pages/edit-mode",
              "features/landing-pages/adding-media",
              "features/landing-pages/using-custom-code"
            ]
          },
          {
            "group": "Variants",
            "pages": [
              "features/variants/working-with-variants",
              "features/variants/managing-variants"
            ]
          },
          {
            "group": "Publishing",
            "pages": [
              "features/publishing/deploying-pages",
              "features/publishing/custom-domains"
            ]
          },
          {
            "group": "Experiment",
            "pages": [
              "features/experiment/running-experiments",
              "features/experiment/best-practices"
            ]
          },
          {
            "group": "Analytics",
            "pages": [
              "features/analytics/capturing-form-data",
              "features/analytics/connecting-google-analytics",
              "features/analytics/traffic-analytics"
            ]
          },
          {
            "group": "Goals",
            "pages": [
              "features/goals/managing-goals",
              "features/goals/tracking-external-goals"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@withblox.com"
      },
      {
        "label": "Dashboard",
        "href": "https://app.withblox.com"
      }
    ]
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
